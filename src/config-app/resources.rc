#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resources.h"

// Multi-size app logo: geometric N over maroon #A62A3A and navy #24558F.
// Tray variants contain only a transparent anti-aliased V or E glyph.
IDI_APP_ICON ICON "neokey.ico"
IDI_TRAY_V_ICON ICON "neokey_tray_v.ico"
IDI_TRAY_E_ICON ICON "neokey_tray_e.ico"

// Dialog template
IDD_CONFIG_DIALOG DIALOGEX 0, 0, 400, 336
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "Neokey Configuration"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_PANEL_METHOD, "Static", SS_NOTIFY, 8, 4, 384, 34
    CONTROL         "", IDC_PANEL_OPTIONS, "Static", SS_NOTIFY, 8, 41, 384, 93
    CONTROL         "", IDC_PANEL_UTILITIES, "Static", SS_NOTIFY, 8, 137, 384, 45
    CONTROL         "", IDC_PANEL_APP_PROFILES, "Static", SS_NOTIFY, 8, 185, 384, 45
    CONTROL         "", IDC_PANEL_HOTKEY, "Static", SS_NOTIFY, 8, 233, 189, 51
    CONTROL         "", IDC_PANEL_STARTUP, "Static", SS_NOTIFY, 203, 233, 189, 51

    LTEXT           "Typing Method", IDC_GROUP_METHOD, 16, 7, 150, 10
    CONTROL         "Telex", IDC_RADIO_TELEX, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP | WS_CLIPSIBLINGS, 16, 18, 115, 16
    CONTROL         "Simple Telex", IDC_RADIO_SIMPLE_TELEX, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP | WS_CLIPSIBLINGS, 137, 18, 126, 16
    CONTROL         "VNI", IDC_RADIO_VNI, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP | WS_CLIPSIBLINGS, 269, 18, 115, 16

    LTEXT           "Correction and bilingual typing", IDC_GROUP_OPTIONS, 16, 44, 200, 10
    LTEXT           "Correction", IDC_STATIC_CORRECTION_COLUMN, 16, 56, 175, 11, WS_CLIPSIBLINGS
    LTEXT           "Vietnamese-English typing", IDC_STATIC_PROTECTION_COLUMN, 205, 56, 179, 11, WS_CLIPSIBLINGS
    CONTROL         "Level:", IDC_STATIC_CORRECTION_LEVEL, "Static", SS_LEFT | SS_CENTERIMAGE | WS_CLIPSIBLINGS, 16, 68, 30, 12
    COMBOBOX        IDC_COMBO_CORRECTION_LEVEL, 48, 68, 118, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_CLIPSIBLINGS
    PUSHBUTTON      "?", IDC_BUTTON_CORRECTION_HELP, 170, 68, 16, 12, WS_CLIPSIBLINGS
    CONTROL         "Mode:", IDC_STATIC_ENGLISH_PROTECTION, "Static", SS_LEFT | SS_CENTERIMAGE | WS_CLIPSIBLINGS, 205, 68, 38, 12
    COMBOBOX        IDC_COMBO_ENGLISH_PROTECTION, 246, 68, 138, 66, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_CLIPSIBLINGS
    AUTOCHECKBOX    "Backspace undoes correction/shorthand", IDC_CHECK_SMART_UNDO, 16, 83, 178, 13
    AUTOCHECKBOX    "Protect URL, email, and code", IDC_CHECK_SMART_CONTEXT_PROTECTION, 205, 83, 179, 13
    AUTOCHECKBOX    "Split joined words (Experimental)", IDC_CHECK_AUTO_WORD_SEGMENTATION, 16, 98, 178, 13
    AUTOCHECKBOX    "Enable fuzzy input", IDC_CHECK_ENABLE_FUZZY_INPUT, 205, 98, 179, 13
    AUTOCHECKBOX    "Auto-capitalize after period", IDC_CHECK_AUTO_CAPITALIZE, 16, 113, 178, 13
    LTEXT           "Off", IDC_STATIC_FUZZY_INPUT_STATUS, 205, 116, 90, 10
    CONTROL         "Configure...", IDC_BUTTON_FUZZY_INPUT_CONFIG, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 298, 113, 86, 14

    LTEXT           "Utilities", IDC_GROUP_UTILITIES, 16, 140, 150, 10
    AUTOCHECKBOX    "Enable shorthand", IDC_CHECK_ENABLE_SHORTHAND, 16, 152, 260, 13, WS_CLIPSIBLINGS
    CONTROL         "Shorthand table...", IDC_BUTTON_SHORTHAND_TABLE, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 298, 152, 86, 14
    LTEXT           "Direct inline/commit modes", IDC_STATIC_DIRECT_APPS, 16, 169, 260, 11, WS_CLIPSIBLINGS
    CONTROL         "Configure...", IDC_BUTTON_DIRECT_APPS, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 298, 168, 86, 14

    LTEXT           "Per-app typing modes", IDC_GROUP_APP_PROFILES, 16, 188, 180, 10
    AUTOCHECKBOX    "Use per-app typing settings", IDC_CHECK_ENABLE_APP_PROFILES, 16, 201, 260, 13, WS_CLIPSIBLINGS
    CONTROL         "Configure apps...", IDC_BUTTON_APP_PROFILES, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 298, 200, 86, 14
    AUTOCHECKBOX    "Automatically remember typing mode/off per app", IDC_CHECK_AUTO_APP_PROFILES, 16, 215, 225, 13, WS_CLIPSIBLINGS
    AUTOCHECKBOX    "Debug log", IDC_CHECK_ENABLE_LOG, 250, 215, 134, 13, WS_CLIPSIBLINGS

    LTEXT           "Hotkey", IDC_GROUP_HOTKEY, 16, 237, 175, 10
    LTEXT           "Turn Neokey on/off", IDC_STATIC_HOTKEY_MODE, 16, 249, 173, 11, WS_CLIPSIBLINGS
    CONTROL         "Ctrl + Shift", IDC_RADIO_HOTKEY_CTRL_SHIFT, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP | WS_CLIPSIBLINGS, 16, 263, 82, 16
    CONTROL         "Alt + Z", IDC_RADIO_HOTKEY_ALT_Z, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP | WS_CLIPSIBLINGS, 103, 263, 82, 16

    LTEXT           "Startup", IDC_STATIC_STARTUP_SECTION, 211, 237, 175, 10
    CONTROL         "Start with Windows", IDC_STATIC_AUTO_START_MODE, "Static", SS_LEFT | SS_CENTERIMAGE, 211, 249, 104, 12
    COMBOBOX        IDC_COMBO_AUTO_START, 318, 248, 66, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Language:", IDC_GROUP_LANGUAGE, "Static", SS_LEFT | SS_CENTERIMAGE, 211, 264, 50, 12
    COMBOBOX        IDC_COMBO_LANGUAGE, 264, 263, 120, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "", IDC_STATIC_FOOTER_SEPARATOR, "Static", SS_ETCHEDHORZ, 0, 288, 400, 1
    LTEXT           "Version: dev", IDC_STATIC_VERSION, 16, 296, 125, 11, WS_CLIPSIBLINGS
    DEFPUSHBUTTON   "OK", IDOK, 222, 293, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 278, 293, 50, 16
    PUSHBUTTON      "Apply", IDAPPLY, 334, 293, 50, 16
END

IDD_FUZZY_INPUT_DIALOG DIALOGEX 0, 0, 300, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Configure Fuzzy Input"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Choose the regional pronunciation differences you commonly type.", IDC_STATIC_FUZZY_INPUT_DESC, 12, 10, 276, 22
    AUTOCHECKBOX    "Mix up L and N", IDC_CHECK_FUZZY_L_N, 14, 38, 272, 14
    AUTOCHECKBOX    "Mix up Tr and Ch", IDC_CHECK_FUZZY_TR_CH, 14, 57, 272, 14
    AUTOCHECKBOX    "Mix up S and X", IDC_CHECK_FUZZY_S_X, 14, 76, 272, 14
    AUTOCHECKBOX    "Mix up R, D, and Gi", IDC_CHECK_FUZZY_R_D_GI, 14, 95, 272, 14
    AUTOCHECKBOX    "Mix up Hỏi and Ngã tones", IDC_CHECK_FUZZY_HOI_NGA, 14, 114, 272, 14
    PUSHBUTTON      "Clear all", IDC_BUTTON_FUZZY_CLEAR_ALL, 14, 146, 74, 18
    DEFPUSHBUTTON   "OK", IDOK, 180, 146, 50, 18
    PUSHBUTTON      "Cancel", IDCANCEL, 238, 146, 50, 18
END

IDD_SHORTHAND_DIALOG DIALOGEX 0, 0, 560, 400
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Bảng Từ Gõ Tắt"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_PANEL_SHORTHAND_VARIABLES, "Static", SS_NOTIFY, 10, 10, 205, 235
    CONTROL         "", IDC_PANEL_SHORTHAND_HELP, "Static", SS_NOTIFY, 10, 252, 205, 108
    LTEXT           "Quy tắc của bạn", IDC_STATIC_SHORTHAND_RULES_LABEL, 225, 11, 325, 11
    CONTROL         "", IDC_EDIT_SHORTHAND_RULES, "RICHEDIT50W", ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | ES_NOHIDESEL | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP, 225, 28, 325, 300
    PUSHBUTTON      "Nhập file...", IDC_BUTTON_IMPORT, 225, 338, 70, 16
    PUSHBUTTON      "Xuất file...", IDC_BUTTON_EXPORT, 301, 338, 70, 16
    DEFPUSHBUTTON   "Lưu", IDOK, 445, 376, 50, 16
    PUSHBUTTON      "Hủy bỏ", IDCANCEL, 500, 376, 50, 16
END

IDD_APP_PROFILES_DIALOG DIALOGEX 0, 0, 360, 245
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Per-app Typing Modes"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Choose a typing mode for each app. Remove a row to inherit global settings.", IDC_STATIC_APP_PROFILES_DESC, 10, 9, 340, 16
    CONTROL         "", IDC_LIST_APP_PROFILES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 28, 340, 145
    LTEXT           "Mode:", IDC_STATIC_APP_PROFILE_MODE, 10, 184, 35, 8
    COMBOBOX        IDC_COMBO_APP_PROFILE_MODE, 48, 180, 90, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Add current", IDC_BUTTON_ADD_CURRENT_APP, 145, 180, 75, 14
    PUSHBUTTON      "Browse...", IDC_BUTTON_BROWSE_APP, 225, 180, 60, 14
    PUSHBUTTON      "Remove", IDC_BUTTON_REMOVE_APP_PROFILE, 290, 180, 60, 14
    DEFPUSHBUTTON   "OK", IDOK, 245, 220, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 300, 220, 50, 14
END

IDD_DIRECT_APPS_DIALOG DIALOGEX 0, 0, 520, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Ứng dụng Direct Inline/Commit"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_STATIC_DIRECT_DESC, "Static", SS_NOTIFY, 10, 10, 500, 72
    EDITTEXT        IDC_EDIT_DIRECT_APPS, 10, 90, 500, 150, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 400, 256, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 460, 256, 50, 16
END


// Embed manifest for Common Controls v6 and Per-Monitor V2 DPI awareness.
1 24 "manifest.xml"
