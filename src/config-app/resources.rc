#include <windows.h>
#include "resources.h"

// Dialog template
IDD_CONFIG_DIALOG DIALOGEX 0, 0, 240, 180
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Neokey Configuration"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Typing Method", IDC_GROUP_METHOD, 10, 10, 220, 75
    AUTORADIOBUTTON "Telex", IDC_RADIO_TELEX, 20, 25, 200, 12, WS_GROUP
    AUTORADIOBUTTON "Simple Telex", IDC_RADIO_SIMPLE_TELEX, 20, 42, 200, 12
    AUTORADIOBUTTON "VNI", IDC_RADIO_VNI, 20, 59, 200, 12

    GROUPBOX        "Options", IDC_GROUP_OPTIONS, 10, 90, 220, 55
    AUTOCHECKBOX    "Enable Auto-Correction (Spell-checking)", IDC_CHECK_AUTO_CORRECT, 20, 105, 200, 12
    AUTOCHECKBOX    "Bật file log để gỡ lỗi (Chỉ dùng khi debug)", IDC_CHECK_ENABLE_LOG, 20, 122, 200, 12

    DEFPUSHBUTTON   "OK", IDOK, 70, 155, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 125, 155, 50, 14
    PUSHBUTTON      "Apply", IDAPPLY, 180, 155, 50, 14
END

// Embed manifest for Common Controls v6 (Visual Styles)
1 24 "manifest.xml"
