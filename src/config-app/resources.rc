#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resources.h"

// Multi-size app logo: geometric N over maroon #A62A3A and navy #24558F.
// Tray variants contain only a transparent anti-aliased V or E glyph.
IDI_APP_ICON ICON "neokey.ico"
IDI_TRAY_V_ICON ICON "neokey_tray_v.ico"
IDI_TRAY_E_ICON ICON "neokey_tray_e.ico"

// Dialog template
IDD_CONFIG_DIALOG DIALOGEX 0, 0, 390, 407
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "Neokey Configuration"
FONT 9, "Segoe UI Variable Text", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_PANEL_METHOD, "Static", SS_NOTIFY, 8, 5, 374, 36
    CONTROL         "", IDC_PANEL_OPTIONS, "Static", SS_NOTIFY, 8, 44, 374, 102
    CONTROL         "", IDC_PANEL_UTILITIES, "Static", SS_NOTIFY, 8, 149, 374, 72
    CONTROL         "", IDC_PANEL_APP_PROFILES, "Static", SS_NOTIFY, 8, 225, 374, 52
    CONTROL         "", IDC_PANEL_HOTKEY, "Static", SS_NOTIFY, 8, 281, 374, 39
    CONTROL         "", IDC_PANEL_STARTUP, "Static", SS_NOTIFY, 8, 324, 374, 54

    LTEXT           "Typing Method", IDC_GROUP_METHOD, 16, 9, 358, 10
    CONTROL         "Telex", IDC_RADIO_TELEX, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP, 18, 21, 112, 17
    CONTROL         "Simple Telex", IDC_RADIO_SIMPLE_TELEX, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 139, 21, 112, 17
    CONTROL         "VNI", IDC_RADIO_VNI, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 260, 21, 112, 17

    LTEXT           "Correction and bilingual typing", IDC_GROUP_OPTIONS, 16, 48, 358, 10
    LTEXT           "Correction", IDC_STATIC_CORRECTION_COLUMN, 18, 61, 170, 9
    LTEXT           "Vietnamese-English typing", IDC_STATIC_PROTECTION_COLUMN, 203, 61, 169, 9
    CONTROL         "Level:", IDC_STATIC_CORRECTION_LEVEL, "Static", SS_LEFT | SS_CENTERIMAGE, 18, 72, 32, 14
    COMBOBOX        IDC_COMBO_CORRECTION_LEVEL, 53, 72, 112, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "?", IDC_BUTTON_CORRECTION_HELP, 170, 72, 18, 12
    CONTROL         "Mode:", IDC_STATIC_ENGLISH_PROTECTION, "Static", SS_LEFT | SS_CENTERIMAGE, 203, 72, 43, 14
    COMBOBOX        IDC_COMBO_ENGLISH_PROTECTION, 250, 72, 122, 66, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Backspace undoes correction/shorthand", IDC_CHECK_SMART_UNDO, 18, 94, 178, 14
    AUTOCHECKBOX    "Split joined words (Experimental)", IDC_CHECK_AUTO_WORD_SEGMENTATION, 18, 111, 178, 14
    AUTOCHECKBOX    "Auto-capitalize after period", IDC_CHECK_AUTO_CAPITALIZE, 18, 128, 178, 14
    AUTOCHECKBOX    "Protect URL, email, and code", IDC_CHECK_SMART_CONTEXT_PROTECTION, 203, 94, 169, 14
    AUTOCHECKBOX    "Enable fuzzy input", IDC_CHECK_ENABLE_FUZZY_INPUT, 203, 111, 169, 14
    LTEXT           "Off", IDC_STATIC_FUZZY_INPUT_STATUS, 203, 130, 78, 10
    CONTROL         "Configure...", IDC_BUTTON_FUZZY_INPUT_CONFIG, "Button", BS_OWNERDRAW | WS_TABSTOP, 285, 125, 87, 18

    LTEXT           "Utilities", IDC_GROUP_UTILITIES, 16, 153, 358, 10
    AUTOCHECKBOX    "Enable shorthand", IDC_CHECK_ENABLE_SHORTHAND, 18, 169, 255, 14
    CONTROL         "Shorthand table...", IDC_BUTTON_SHORTHAND_TABLE, "Button", BS_OWNERDRAW | WS_TABSTOP, 285, 165, 87, 18
    AUTOCHECKBOX    "Enable debug logging (Use for debugging only)", IDC_CHECK_ENABLE_LOG, 18, 187, 354, 14
    LTEXT           "Direct inline/commit modes", IDC_STATIC_DIRECT_APPS, 18, 207, 255, 9
    CONTROL         "Configure...", IDC_BUTTON_DIRECT_APPS, "Button", BS_OWNERDRAW | WS_TABSTOP, 285, 201, 87, 18

    LTEXT           "Per-app typing modes", IDC_GROUP_APP_PROFILES, 16, 229, 358, 10
    AUTOCHECKBOX    "Use per-app typing settings", IDC_CHECK_ENABLE_APP_PROFILES, 18, 245, 354, 14
    AUTOCHECKBOX    "Automatically remember typing mode/off per app", IDC_CHECK_AUTO_APP_PROFILES, 18, 261, 255, 13
    CONTROL         "Configure apps...", IDC_BUTTON_APP_PROFILES, "Button", BS_OWNERDRAW | WS_TABSTOP, 285, 256, 87, 18

    LTEXT           "Hotkey", IDC_GROUP_HOTKEY, 16, 285, 358, 10
    LTEXT           "Turn Neokey on/off", IDC_STATIC_HOTKEY_MODE, 18, 303, 152, 9
    CONTROL         "Ctrl + Shift", IDC_RADIO_HOTKEY_CTRL_SHIFT, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP, 176, 296, 94, 18
    CONTROL         "Alt + Z", IDC_RADIO_HOTKEY_ALT_Z, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 278, 296, 94, 18

    LTEXT           "Startup", IDC_STATIC_STARTUP_SECTION, 16, 328, 358, 10
    CONTROL         "Start with Windows", IDC_STATIC_AUTO_START_MODE, "Static", SS_LEFT | SS_CENTERIMAGE, 18, 344, 104, 14
    COMBOBOX        IDC_COMBO_AUTO_START, 124, 344, 66, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Language:", IDC_GROUP_LANGUAGE, "Static", SS_LEFT | SS_CENTERIMAGE, 205, 344, 52, 14
    COMBOBOX        IDC_COMBO_LANGUAGE, 260, 344, 112, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Starts only the configuration app; the IME runs independently.", IDC_STATIC_STARTUP_DESC, 18, 365, 354, 10

    CONTROL         "", IDC_STATIC_FOOTER_SEPARATOR, "Static", SS_ETCHEDHORZ, 0, 380, 390, 1
    LTEXT           "Version: dev", IDC_STATIC_VERSION, 18, 391, 125, 9
    DEFPUSHBUTTON   "OK", IDOK, 212, 386, 50, 18
    PUSHBUTTON      "Cancel", IDCANCEL, 270, 386, 50, 18
    PUSHBUTTON      "Apply", IDAPPLY, 328, 386, 50, 18
END

IDD_FUZZY_INPUT_DIALOG DIALOGEX 0, 0, 300, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Configure Fuzzy Input"
FONT 9, "Segoe UI Variable Text", 400, 0, 0x1
BEGIN
    LTEXT           "Choose the regional pronunciation differences you commonly type.", IDC_STATIC_FUZZY_INPUT_DESC, 12, 10, 276, 22
    AUTOCHECKBOX    "Mix up L and N", IDC_CHECK_FUZZY_L_N, 14, 38, 272, 14
    AUTOCHECKBOX    "Mix up Tr and Ch", IDC_CHECK_FUZZY_TR_CH, 14, 57, 272, 14
    AUTOCHECKBOX    "Mix up S and X", IDC_CHECK_FUZZY_S_X, 14, 76, 272, 14
    AUTOCHECKBOX    "Mix up R, D, and Gi", IDC_CHECK_FUZZY_R_D_GI, 14, 95, 272, 14
    AUTOCHECKBOX    "Mix up Hỏi and Ngã tones", IDC_CHECK_FUZZY_HOI_NGA, 14, 114, 272, 14
    PUSHBUTTON      "Clear all", IDC_BUTTON_FUZZY_CLEAR_ALL, 14, 146, 74, 18
    DEFPUSHBUTTON   "OK", IDOK, 180, 146, 50, 18
    PUSHBUTTON      "Cancel", IDCANCEL, 238, 146, 50, 18
END

IDD_SHORTHAND_DIALOG DIALOGEX 0, 0, 560, 400
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Bảng Từ Gõ Tắt"
FONT 9, "Segoe UI Variable Text", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_PANEL_SHORTHAND_VARIABLES, "Static", SS_NOTIFY, 10, 10, 205, 235
    CONTROL         "", IDC_PANEL_SHORTHAND_HELP, "Static", SS_NOTIFY, 10, 252, 205, 108
    LTEXT           "Quy tắc của bạn", IDC_STATIC_SHORTHAND_RULES_LABEL, 225, 11, 325, 11
    CONTROL         "", IDC_EDIT_SHORTHAND_RULES, "RICHEDIT50W", ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | ES_NOHIDESEL | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP, 225, 28, 325, 300
    PUSHBUTTON      "Nhập file...", IDC_BUTTON_IMPORT, 225, 338, 70, 16
    PUSHBUTTON      "Xuất file...", IDC_BUTTON_EXPORT, 301, 338, 70, 16
    DEFPUSHBUTTON   "Lưu", IDOK, 445, 376, 50, 16
    PUSHBUTTON      "Hủy bỏ", IDCANCEL, 500, 376, 50, 16
END

IDD_APP_PROFILES_DIALOG DIALOGEX 0, 0, 360, 245
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Per-app Typing Modes"
FONT 9, "Segoe UI Variable Text", 400, 0, 0x1
BEGIN
    LTEXT           "Choose a typing mode for each app. Remove a row to inherit global settings.", IDC_STATIC_APP_PROFILES_DESC, 10, 9, 340, 16
    CONTROL         "", IDC_LIST_APP_PROFILES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 28, 340, 145
    LTEXT           "Mode:", IDC_STATIC_APP_PROFILE_MODE, 10, 184, 35, 8
    COMBOBOX        IDC_COMBO_APP_PROFILE_MODE, 48, 180, 90, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Add current", IDC_BUTTON_ADD_CURRENT_APP, 145, 180, 75, 14
    PUSHBUTTON      "Browse...", IDC_BUTTON_BROWSE_APP, 225, 180, 60, 14
    PUSHBUTTON      "Remove", IDC_BUTTON_REMOVE_APP_PROFILE, 290, 180, 60, 14
    DEFPUSHBUTTON   "OK", IDOK, 245, 220, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 300, 220, 50, 14
END

IDD_DIRECT_APPS_DIALOG DIALOGEX 0, 0, 520, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Ứng dụng Direct Inline/Commit"
FONT 9, "Segoe UI Variable Text", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_STATIC_DIRECT_DESC, "Static", SS_NOTIFY, 10, 10, 500, 72
    EDITTEXT        IDC_EDIT_DIRECT_APPS, 10, 90, 500, 150, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 400, 256, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 460, 256, 50, 16
END


// Embed manifest for Common Controls v6 and Per-Monitor V2 DPI awareness.
1 24 "manifest.xml"
