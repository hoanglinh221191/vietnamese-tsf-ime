#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resources.h"

// Multi-size app logo: geometric N over maroon #A62A3A and navy #24558F.
// Tray variants contain only a transparent anti-aliased V or E glyph.
IDI_APP_ICON ICON "neokey.ico"
IDI_TRAY_V_ICON ICON "neokey_tray_v.ico"
IDI_TRAY_E_ICON ICON "neokey_tray_e.ico"

// Dialog template
//
// WS_EX_COMPOSITED double-buffers the window and its children: the erase and
// every control paint go to an off-screen bitmap and reach the screen as one
// blit. Without it a page switch is a background fill followed by the controls
// drawing over it, which is visible as a flash however few passes it takes.
// It pairs with WS_CLIPCHILDREN, which is already here, and it is safe because
// nothing in this app draws outside WM_PAINT - the one GetDC reads the DPI.
IDD_CONFIG_DIALOG DIALOGEX 0, 0, 400, 330
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW | WS_EX_COMPOSITED
CAPTION "Neokey Configuration"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_PANEL_METHOD, "Static", SS_NOTIFY, 8, 4, 384, 34
    CONTROL         "", IDC_PANEL_NAV, "Static", SS_NOTIFY, 8, 41, 96, 258
    CONTROL         "", IDC_PANEL_OPTIONS, "Static", SS_NOTIFY, 108, 41, 284, 258

    LTEXT           "Typing Method", IDC_GROUP_METHOD, 16, 7, 150, 10
    CONTROL         "Telex", IDC_RADIO_TELEX, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP | WS_CLIPSIBLINGS, 16, 18, 115, 16
    CONTROL         "Simple Telex", IDC_RADIO_SIMPLE_TELEX, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP | WS_CLIPSIBLINGS, 137, 18, 126, 16
    CONTROL         "VNI", IDC_RADIO_VNI, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP | WS_CLIPSIBLINGS, 269, 18, 115, 16

    CONTROL         "Correction", IDC_BUTTON_NAV_CORRECTION, "Button", BS_OWNERDRAW | WS_GROUP | WS_TABSTOP | WS_CLIPSIBLINGS, 14, 47, 84, 20
    CONTROL         "Vietnamese typing", IDC_BUTTON_NAV_TYPING, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 14, 70, 84, 20
    CONTROL         "Utilities", IDC_BUTTON_NAV_UTILITIES, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 14, 93, 84, 20
    CONTROL         "Applications", IDC_BUTTON_NAV_APPS, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 14, 116, 84, 20
    CONTROL         "Hotkey and startup", IDC_BUTTON_NAV_HOTKEY, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 14, 139, 84, 20

    LTEXT           "Correction and bilingual typing", IDC_GROUP_OPTIONS, 116, 48, 260, 10
    CONTROL         "Level:", IDC_STATIC_CORRECTION_LEVEL, "Static", SS_LEFT | SS_CENTERIMAGE | WS_CLIPSIBLINGS, 116, 62, 30, 12
    COMBOBOX        IDC_COMBO_CORRECTION_LEVEL, 148, 62, 200, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_CLIPSIBLINGS
    PUSHBUTTON      "?", IDC_BUTTON_CORRECTION_HELP, 352, 62, 16, 12, WS_CLIPSIBLINGS
    AUTOCHECKBOX    "Backspace undoes correction/shorthand", IDC_CHECK_SMART_UNDO, 116, 79, 260, 13
    AUTOCHECKBOX    "Split joined words (Experimental)", IDC_CHECK_AUTO_WORD_SEGMENTATION, 116, 93, 260, 13
    LTEXT           "Vietnamese-English typing", IDC_STATIC_PROTECTION_COLUMN, 116, 111, 260, 11, WS_CLIPSIBLINGS
    CONTROL         "Mode:", IDC_STATIC_ENGLISH_PROTECTION, "Static", SS_LEFT | SS_CENTERIMAGE | WS_CLIPSIBLINGS, 116, 125, 38, 12
    COMBOBOX        IDC_COMBO_ENGLISH_PROTECTION, 156, 125, 212, 66, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_CLIPSIBLINGS
    AUTOCHECKBOX    "Protect URL, email, and code", IDC_CHECK_SMART_CONTEXT_PROTECTION, 116, 142, 260, 13
    AUTOCHECKBOX    "Enable fuzzy input", IDC_CHECK_ENABLE_FUZZY_INPUT, 116, 156, 260, 13
    LTEXT           "Off", IDC_STATIC_FUZZY_INPUT_STATUS, 130, 173, 140, 10
    CONTROL         "Configure...", IDC_BUTTON_FUZZY_INPUT_CONFIG, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 282, 171, 86, 12

    LTEXT           "Vietnamese typing", IDC_STATIC_CORRECTION_COLUMN, 116, 48, 260, 10, WS_CLIPSIBLINGS
    AUTOCHECKBOX    "Free typing (joined names)", IDC_CHECK_FREE_TYPING, 116, 62, 260, 13
    AUTOCHECKBOX    "Underscore separates words", IDC_CHECK_UNDERSCORE_SEPARATOR, 116, 76, 260, 13
    AUTOCHECKBOX    "Auto-capitalize after period", IDC_CHECK_AUTO_CAPITALIZE, 116, 90, 260, 13
    AUTOCHECKBOX    "Try another mode when an app shows a floating input box", IDC_CHECK_AUTO_SYNTHETIC_FALLBACK, 116, 104, 260, 13
    AUTOCHECKBOX    "VNI tones on the numeric keypad", IDC_CHECK_VNI_NUMPAD, 116, 118, 260, 13
    AUTOCHECKBOX    "New-style tone marks (hoa, khoe, thuy)", IDC_CHECK_NEW_STYLE_TONE, 116, 132, 260, 13
    AUTOCHECKBOX    "Quick Telex (tt=th, nn=ng, cc=ch)", IDC_CHECK_QUICK_TELEX, 116, 146, 260, 13
    AUTOCHECKBOX    "Alt+Backspace turns the word back into English", IDC_CHECK_ENGLISH_RESTORE_HOTKEY, 116, 160, 260, 13
    AUTOCHECKBOX    "Backspace in a mistyped word drops its marks (Experimental)", IDC_CHECK_STRIP_MARKS_ON_BACKSPACE, 116, 174, 260, 13
    CONTROL         "Keyboard:", IDC_STATIC_KEYBOARD_LAYOUT, "Static", SS_LEFT | SS_CENTERIMAGE | WS_CLIPSIBLINGS, 116, 193, 110, 12
    COMBOBOX        IDC_COMBO_KEYBOARD_LAYOUT, 232, 192, 136, 96, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_CLIPSIBLINGS

    LTEXT           "Utilities", IDC_GROUP_UTILITIES, 116, 48, 260, 10
    AUTOCHECKBOX    "Enable shorthand", IDC_CHECK_ENABLE_SHORTHAND, 116, 62, 160, 13, WS_CLIPSIBLINGS
    CONTROL         "Shorthand table...", IDC_BUTTON_SHORTHAND_TABLE, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 282, 62, 86, 12
    LTEXT           "Direct inline/commit modes", IDC_STATIC_DIRECT_APPS, 116, 81, 160, 11, WS_CLIPSIBLINGS
    CONTROL         "Configure...", IDC_BUTTON_DIRECT_APPS, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 282, 80, 86, 12

    LTEXT           "Per-app typing modes", IDC_GROUP_APP_PROFILES, 116, 48, 260, 10
    AUTOCHECKBOX    "Use per-app typing settings", IDC_CHECK_ENABLE_APP_PROFILES, 116, 62, 160, 13, WS_CLIPSIBLINGS
    CONTROL         "Configure apps...", IDC_BUTTON_APP_PROFILES, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 282, 62, 86, 12
    AUTOCHECKBOX    "Automatically remember typing mode/off per app", IDC_CHECK_AUTO_APP_PROFILES, 116, 81, 260, 13, WS_CLIPSIBLINGS
    AUTOCHECKBOX    "Debug log", IDC_CHECK_ENABLE_LOG, 116, 95, 260, 13, WS_CLIPSIBLINGS

    LTEXT           "Hotkey", IDC_GROUP_HOTKEY, 116, 48, 260, 10
    LTEXT           "Turn Neokey on/off", IDC_STATIC_HOTKEY_MODE, 116, 62, 260, 11, WS_CLIPSIBLINGS
    CONTROL         "Ctrl + Shift", IDC_RADIO_HOTKEY_CTRL_SHIFT, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP | WS_CLIPSIBLINGS, 116, 76, 116, 16
    CONTROL         "Alt + Z", IDC_RADIO_HOTKEY_ALT_Z, "Button", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP | WS_CLIPSIBLINGS, 238, 76, 116, 16
    AUTOCHECKBOX    "Turn off the Windows keyboard-switch shortcut", IDC_CHECK_DISABLE_WIN_LAYOUT_HOTKEY, 116, 97, 260, 13, WS_CLIPSIBLINGS
    LTEXT           "Startup", IDC_STATIC_STARTUP_SECTION, 116, 118, 260, 10
    CONTROL         "Start with Windows", IDC_STATIC_AUTO_START_MODE, "Static", SS_LEFT | SS_CENTERIMAGE, 116, 132, 110, 12
    COMBOBOX        IDC_COMBO_AUTO_START, 232, 131, 90, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Language:", IDC_GROUP_LANGUAGE, "Static", SS_LEFT | SS_CENTERIMAGE, 116, 149, 110, 12
    COMBOBOX        IDC_COMBO_LANGUAGE, 232, 148, 136, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Use Neokey on the sign-in and lock screen", IDC_CHECK_SIGN_IN_SCREEN, 116, 166, 260, 13, WS_CLIPSIBLINGS

    CONTROL         "", IDC_STATIC_FOOTER_SEPARATOR, "Static", SS_ETCHEDHORZ, 0, 303, 400, 1
    LTEXT           "Version: dev", IDC_STATIC_VERSION, 16, 311, 125, 11, WS_CLIPSIBLINGS
    DEFPUSHBUTTON   "OK", IDOK, 222, 308, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 278, 308, 50, 16
    PUSHBUTTON      "Apply", IDAPPLY, 334, 308, 50, 16

END

IDD_FUZZY_INPUT_DIALOG DIALOGEX 0, 0, 300, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Configure Fuzzy Input"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Choose the regional pronunciation differences you commonly type.", IDC_STATIC_FUZZY_INPUT_DESC, 12, 10, 276, 22
    AUTOCHECKBOX    "Mix up L and N", IDC_CHECK_FUZZY_L_N, 14, 38, 272, 14
    AUTOCHECKBOX    "Mix up Tr and Ch", IDC_CHECK_FUZZY_TR_CH, 14, 57, 272, 14
    AUTOCHECKBOX    "Mix up S and X", IDC_CHECK_FUZZY_S_X, 14, 76, 272, 14
    AUTOCHECKBOX    "Mix up R, D, and Gi", IDC_CHECK_FUZZY_R_D_GI, 14, 95, 272, 14
    AUTOCHECKBOX    "Mix up Hỏi and Ngã tones", IDC_CHECK_FUZZY_HOI_NGA, 14, 114, 272, 14
    PUSHBUTTON      "Clear all", IDC_BUTTON_FUZZY_CLEAR_ALL, 14, 146, 74, 18
    DEFPUSHBUTTON   "OK", IDOK, 180, 146, 50, 18
    PUSHBUTTON      "Cancel", IDCANCEL, 238, 146, 50, 18
END

IDD_SHORTHAND_DIALOG DIALOGEX 0, 0, 560, 400
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Bảng Từ Gõ Tắt"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_PANEL_SHORTHAND_VARIABLES, "Static", SS_NOTIFY, 10, 10, 205, 235
    CONTROL         "", IDC_PANEL_SHORTHAND_HELP, "Static", SS_NOTIFY, 10, 252, 205, 108
    LTEXT           "Quy tắc của bạn", IDC_STATIC_SHORTHAND_RULES_LABEL, 225, 11, 325, 11
    CONTROL         "", IDC_EDIT_SHORTHAND_RULES, "RICHEDIT50W", ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | ES_NOHIDESEL | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP, 225, 28, 325, 300
    PUSHBUTTON      "Nhập file...", IDC_BUTTON_IMPORT, 225, 338, 70, 16
    PUSHBUTTON      "Xuất file...", IDC_BUTTON_EXPORT, 301, 338, 70, 16
    DEFPUSHBUTTON   "Lưu", IDOK, 445, 376, 50, 16
    PUSHBUTTON      "Hủy bỏ", IDCANCEL, 500, 376, 50, 16
END

IDD_APP_PROFILES_DIALOG DIALOGEX 0, 0, 520, 245
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Per-app Typing Modes"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Choose a typing mode for each app. Remove a row to inherit global settings.", IDC_STATIC_APP_PROFILES_DESC, 10, 9, 500, 16
    CONTROL         "", IDC_LIST_APP_PROFILES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 28, 500, 145
    LTEXT           "Mode:", IDC_STATIC_APP_PROFILE_MODE, 10, 184, 35, 8
    COMBOBOX        IDC_COMBO_APP_PROFILE_MODE, 48, 180, 90, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Add current", IDC_BUTTON_ADD_CURRENT_APP, 145, 180, 75, 14
    PUSHBUTTON      "Browse...", IDC_BUTTON_BROWSE_APP, 225, 180, 60, 14
    PUSHBUTTON      "Remove", IDC_BUTTON_REMOVE_APP_PROFILE, 290, 180, 60, 14
    PUSHBUTTON      "Remove missing apps", IDC_BUTTON_PRUNE_MISSING_APPS, 10, 200, 120, 14
    PUSHBUTTON      "Reset all to global mode", IDC_BUTTON_RESET_APP_METHODS, 135, 200, 145, 14
    DEFPUSHBUTTON   "OK", IDOK, 405, 220, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 460, 220, 50, 14
END

IDD_DIRECT_APPS_DIALOG DIALOGEX 0, 0, 520, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Ứng dụng Direct Inline/Commit"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_BUTTON_TAB_DIRECT, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 10, 8, 165, 16
    CONTROL         "", IDC_BUTTON_TAB_CLASSES, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 178, 8, 165, 16
    CONTROL         "", IDC_BUTTON_TAB_ENTER, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_CLIPSIBLINGS, 346, 8, 164, 16
    CONTROL         "", IDC_STATIC_DIRECT_DESC, "Static", SS_NOTIFY, 10, 32, 500, 66
    EDITTEXT        IDC_EDIT_DIRECT_APPS, 10, 104, 500, 88, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    CONTROL         "", IDC_STATIC_NATIVE_CLASSES, "Static", SS_NOTIFY, 10, 32, 500, 66
    EDITTEXT        IDC_EDIT_NATIVE_CLASSES, 10, 104, 500, 88, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    CONTROL         "", IDC_STATIC_ENTER_APPS, "Static", SS_NOTIFY, 10, 32, 500, 66
    EDITTEXT        IDC_EDIT_ENTER_APPS, 10, 104, 500, 88, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 400, 204, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 460, 204, 50, 16
END


// Embed manifest for Common Controls v6 and Per-Monitor V2 DPI awareness.
1 24 "manifest.xml"
