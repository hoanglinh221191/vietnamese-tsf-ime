#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resources.h"

// Application Icon
IDI_APP_ICON ICON "neokey.ico"

// Dialog template
IDD_CONFIG_DIALOG DIALOGEX 0, 0, 270, 415
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Neokey Configuration"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Typing Method", IDC_GROUP_METHOD, 10, 10, 250, 36
    AUTORADIOBUTTON "Telex", IDC_RADIO_TELEX, 20, 25, 55, 12, WS_GROUP
    AUTORADIOBUTTON "Simple Telex", IDC_RADIO_SIMPLE_TELEX, 85, 25, 95, 12
    AUTORADIOBUTTON "VNI", IDC_RADIO_VNI, 195, 25, 50, 12

    GROUPBOX        "Options", IDC_GROUP_OPTIONS, 10, 50, 250, 122
    LTEXT           "Auto-Correction Level:", IDC_STATIC_CORRECTION_LEVEL, 20, 67, 92, 8
    COMBOBOX        IDC_COMBO_CORRECTION_LEVEL, 115, 64, 115, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "?", IDC_BUTTON_CORRECTION_HELP, 234, 63, 16, 14
    LTEXT           "English protection:", IDC_STATIC_ENGLISH_PROTECTION, 20, 84, 92, 8
    COMBOBOX        IDC_COMBO_ENGLISH_PROTECTION, 115, 81, 135, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Enable debug logging (Use for debugging only)", IDC_CHECK_ENABLE_LOG, 20, 101, 230, 12
    AUTOCHECKBOX    "Enable shorthand", IDC_CHECK_ENABLE_SHORTHAND, 20, 118, 145, 12
    PUSHBUTTON      "Shorthand table...", IDC_BUTTON_SHORTHAND_TABLE, 175, 117, 75, 14
    AUTOCHECKBOX    "Auto-capitalize after period", IDC_CHECK_AUTO_CAPITALIZE, 20, 135, 230, 12
    LTEXT           "Direct inline/commit modes:", IDC_STATIC_DIRECT_APPS, 20, 153, 145, 8
    PUSHBUTTON      "Configure...", IDC_BUTTON_DIRECT_APPS, 175, 150, 75, 14

    GROUPBOX        "Per-app typing modes", IDC_GROUP_APP_PROFILES, 10, 177, 250, 66
    AUTOCHECKBOX    "Use per-app typing settings", IDC_CHECK_ENABLE_APP_PROFILES, 20, 193, 230, 12
    AUTOCHECKBOX    "Automatically remember typing mode/off per app", IDC_CHECK_AUTO_APP_PROFILES, 20, 210, 230, 12
    PUSHBUTTON      "Configure apps...", IDC_BUTTON_APP_PROFILES, 165, 225, 85, 14

    GROUPBOX        "Hotkey to turn NeoKey on/off", IDC_GROUP_HOTKEY, 10, 248, 250, 40
    AUTORADIOBUTTON "Ctrl + Shift", IDC_RADIO_HOTKEY_CTRL_SHIFT, 20, 263, 90, 12, WS_GROUP
    AUTORADIOBUTTON "Alt + Z", IDC_RADIO_HOTKEY_ALT_Z, 125, 263, 90, 12

    GROUPBOX        "Language & Typing Mode", IDC_GROUP_LANGUAGE, 10, 293, 250, 40
    AUTORADIOBUTTON "Tiếng Việt", IDC_RADIO_LANG_VIE, 20, 308, 90, 12, WS_GROUP
    AUTORADIOBUTTON "English", IDC_RADIO_LANG_ENG, 125, 308, 90, 12

    AUTOCHECKBOX    "Start the configuration app with Windows", IDC_CHECK_AUTO_START, 20, 340, 235, 12
    LTEXT           "Starts only the configuration app; the IME runs independently.", IDC_STATIC_STARTUP_DESC, 20, 355, 235, 18
    LTEXT           "Version: dev", IDC_STATIC_VERSION, 20, 377, 235, 10

    DEFPUSHBUTTON   "OK", IDOK, 90, 396, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 145, 396, 50, 14
    PUSHBUTTON      "Apply", IDAPPLY, 200, 396, 50, 14
END

IDD_SHORTHAND_DIALOG DIALOGEX 0, 0, 300, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bảng Từ Gõ Tắt"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Nhập các quy tắc gõ tắt (ví dụ: vn=Việt Nam). Mỗi quy tắc trên một dòng.", IDC_STATIC_SHORTHAND_DESC, 10, 10, 280, 18
    EDITTEXT        IDC_EDIT_SHORTHAND_RULES, 10, 30, 280, 160, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL
    PUSHBUTTON      "Import...", IDC_BUTTON_IMPORT, 10, 200, 50, 14
    PUSHBUTTON      "Export...", IDC_BUTTON_EXPORT, 65, 200, 50, 14
    DEFPUSHBUTTON   "Lưu", IDOK, 185, 225, 50, 14
    PUSHBUTTON      "Hủy bỏ", IDCANCEL, 240, 225, 50, 14
END

IDD_APP_PROFILES_DIALOG DIALOGEX 0, 0, 360, 245
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Per-app Typing Modes"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Choose a typing mode for each app. Remove a row to inherit global settings.", IDC_STATIC_APP_PROFILES_DESC, 10, 9, 340, 16
    CONTROL         "", IDC_LIST_APP_PROFILES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 28, 340, 145
    LTEXT           "Mode:", IDC_STATIC_APP_PROFILE_MODE, 10, 184, 35, 8
    COMBOBOX        IDC_COMBO_APP_PROFILE_MODE, 48, 180, 90, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Add current", IDC_BUTTON_ADD_CURRENT_APP, 145, 180, 75, 14
    PUSHBUTTON      "Browse...", IDC_BUTTON_BROWSE_APP, 225, 180, 60, 14
    PUSHBUTTON      "Remove", IDC_BUTTON_REMOVE_APP_PROFILE, 290, 180, 60, 14
    DEFPUSHBUTTON   "OK", IDOK, 245, 220, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 300, 220, 50, 14
END

IDD_DIRECT_APPS_DIALOG DIALOGEX 0, 0, 300, 230
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ứng dụng Direct Inline/Commit"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Mỗi dòng nhập một tiến trình kèm chế độ. Ví dụ:\n- app.exe hoặc app.exe:inline (Direct Inline, hoàn tác khi bấm ESC)\n- app.exe:commit (Direct Commit, không chặn phím ESC)\nCác app mặc định (notepad++, explorer, filezilla) tự động hỗ trợ direct inline/commit.", IDC_STATIC_DIRECT_DESC, 10, 8, 280, 42
    EDITTEXT        IDC_EDIT_DIRECT_APPS, 10, 54, 280, 130, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 185, 205, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 240, 205, 50, 14
END


// Embed manifest for Common Controls v6 (Visual Styles)
1 24 "manifest.xml"
